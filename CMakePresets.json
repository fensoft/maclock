{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-debug",
      "displayName": "Maclock Simulator - Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-release",
      "displayName": "Maclock Simulator - Release",
      "inherits": "macos-debug",
      "binaryDir": "${sourceDir}/build/macos-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-asan",
      "displayName": "Maclock Simulator - AddressSanitizer",
      "inherits": "macos-debug",
      "binaryDir": "${sourceDir}/build/macos-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "jobs": 8
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "jobs": 8
    },
    {
      "name": "macos-asan",
      "configurePreset": "macos-asan",
      "jobs": 8
    }
  ]
}
