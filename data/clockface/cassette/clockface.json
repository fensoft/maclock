{
  "format": "maclock-clock-face",
  "version": 1,
  "name": "Cassette",
  "width": 304,
  "height": 224,
  "background": "#ffffff",
  "random_interval_seconds": 60,
  "objects": [
    {
      "id": "background",
      "type": "image",
      "template": "cassette.png",
      "x": 0,
      "y": 17,
      "width": 304,
      "height": 224,
      "keep_ratio": true,
      "visible_if": ""
    },
    {
      "id": "time",
      "type": "text",
      "x": 59,
      "y": 41,
      "width": 220,
      "height": 30,
      "stroke": "#000000",
      "template": "{time_min}",
      "font_family": "lv_font_chicago_24",
      "font_size": 24,
      "align": "center",
      "visible_if": "rtc_available",
      "random": []
    },
    {
      "id": "seconds",
      "type": "text",
      "x": 193,
      "y": 53,
      "width": 44,
      "height": 12,
      "stroke": "#000000",
      "template": ":{second}",
      "font_family": "lv_font_chicago_8",
      "font_size": 8,
      "align": "center",
      "visible_if": "show_time_seconds",
      "random": []
    }
  ]
}
