{
  "format": "maclock-clock-face",
  "version": 1,
  "name": "Windows XP",
  "width": 304,
  "height": 224,
  "background": "#3f88d6",
  "random_interval_seconds": 60,
  "translations": {
    "calculator": { "en": "Calculator", "fr": "Calculatrice", "es": "Calculadora", "de": "Rechner", "it": "Calcolatrice" },
    "today": { "en": "Today", "fr": "Auj.", "es": "Hoy", "de": "Heute", "it": "Oggi" }
  },
  "objects": [
    { "id": "background", "type": "image", "template": "background.png", "x": 0, "y": 0, "width": 304, "height": 224, "keep_ratio": true, "visible_if": "" },
    { "id": "calculator", "type": "image", "template": "calc.png", "x": 22, "y": 26, "width": 260, "height": 151, "keep_ratio": true, "visible_if": "" },
    { "id": "calculator_title", "type": "text", "x": 45, "y": 34, "width": 160, "height": 12, "stroke": "#ffffff", "template": "{tr.calculator}", "font_family": "lv_font_chicago_8", "font_size": 8, "align": "left", "visible_if": "", "random": [] },
    { "id": "calculator_label", "type": "text", "x": 32, "y": 61, "width": 240, "height": 10, "stroke": "#454545", "template": "{tr.today}", "font_family": "lv_font_chicago_8", "font_size": 8, "align": "center", "visible_if": "", "random": [] },
    { "id": "time", "type": "text", "x": 32, "y": 67, "width": 240, "height": 42, "stroke": "#174a8a", "template": "{time}", "font_family": "lv_font_chicago_32", "font_size": 32, "align": "center", "visible_if": "rtc_available", "random": [] },
    { "id": "date", "type": "text", "x": 32, "y": 116, "width": 240, "height": 12, "stroke": "#454545", "template": "{weekday_short} {date}", "font_family": "lv_font_chicago_8", "font_size": 8, "align": "center", "visible_if": "rtc_available", "random": [] },
    { "id": "weather", "type": "text", "x": 32, "y": 139, "width": 240, "height": 12, "stroke": "#454545", "template": "{city}  {external_temp}{temperature_unit}", "font_family": "lv_font_chicago_8", "font_size": 8, "align": "center", "visible_if": "weather_available", "random": [] },
    { "id": "menu", "type": "image", "template": "menu.png", "x": 0, "y": 194, "width": 304, "height": 30, "keep_ratio": true, "visible_if": "" },
    { "id": "tray_time", "type": "text", "x": 249, "y": 204, "width": 48, "height": 10, "stroke": "#ffffff", "template": "{time_min}", "font_family": "lv_font_chicago_8", "font_size": 8, "align": "right", "visible_if": "rtc_available", "random": [] }
  ]
}
