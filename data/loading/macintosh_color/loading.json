{
  "format": "maclock-loading-screen",
  "version": 1,
  "name": "Macintosh Color",
  "protected": true,
  "width": 304,
  "height": 224,
  "background": "#ffffff",
  "sound": "/floppy.mp3",
  "sound_volume": 60,
  "random_interval_seconds": 60,
  "translations": {
    "welcome": { "en": "Welcome to Maclock", "fr": "Bienvenue sur Maclock", "es": "Bienvenido a Maclock", "de": "Willkommen bei Maclock", "it": "Benvenuto in Maclock" }
  },
  "objects": [
    {
      "id": "background",
      "type": "image",
      "template": "background.png",
      "x": 0,
      "y": 0,
      "width": 304,
      "height": 224,
      "keep_ratio": true,
      "visible_if": ""
    },
    {
      "id": "boot",
      "type": "image",
      "template": "boot.png",
      "x": 22,
      "y": 48,
      "width": 261,
      "height": 129,
      "keep_ratio": true,
      "visible_if": ""
    },
    {
      "id": "module",
      "type": "image",
      "template": "plugin_{i2c}.png",
      "x": 8,
      "y": 184,
      "width": 32,
      "height": 32,
      "keep_ratio": true,
      "next_module_x": 36,
      "next_module_y": 0,
      "visible_if": ""
    },
    {
      "id": "welcome",
      "type": "text",
      "x": 64,
      "y": 80,
      "width": 244,
      "height": 12,
      "stroke": "#000000",
      "template": "{tr.welcome}",
      "font_family": "lv_font_chicago_8",
      "font_size": 8,
      "align": "center",
      "visible_if": "",
      "random": []
    }
  ]
}
